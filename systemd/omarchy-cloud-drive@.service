[Unit]
Description=Omarchy cloud drive mount (%i)
Documentation=file://%h/.config/omarchy/plugins/edbron.cloud-drives/README.md
After=network-online.target graphical-session.target
Wants=network-online.target
# The config password lives in the login keyring; without a session bus we
# cannot read it, so stay attached to the graphical session.
PartOf=graphical-session.target

[Service]
Type=notify
Environment="XDG_DATA_HOME=@DATA@"
# The user manager may have imported these settings. Remove loader/debug
# controls before Python starts; sanitizing worker children is too late here.
UnsetEnvironment=LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH LD_DEBUG LD_DEBUG_OUTPUT LD_PROFILE LD_PROFILE_OUTPUT LD_TRACE_LOADED_OBJECTS GLIBC_TUNABLES GCONV_PATH LOCPATH
# Worker removes inherited rclone options and selects the account-specific
# cache recorded inside the encrypted config, then execs rclone in this PID.
ExecStart=/usr/bin/python3 -Es "@WORKER@" %i "@CONFIG@" "@MOUNT@" "@CACHE@"
LimitCORE=0
CoredumpFilter=0x0
StandardOutput=null
StandardError=null
KillSignal=SIGINT
TimeoutStopSec=40
Restart=on-failure
RestartSec=10
TimeoutStartSec=45
UMask=0077
# fusermount3 is setuid root, so NoNewPrivileges/RestrictSUIDSGID would break
# the mount. Unprivileged FUSE is the security boundary here instead.
# No mount-namespace sandboxing (PrivateTmp, ProtectSystem/Home/Kernel*/ControlGroups):
# each of those puts the service in a private mount namespace, where fusermount3
# refuses to mount and the FUSE mount would be invisible to the session anyway.
# Nor seccomp options (LockPersonality, RestrictRealtime, SystemCallFilter...):
# for user services they imply no_new_privs, which also breaks fusermount3.

[Install]
WantedBy=graphical-session.target
