#!/bin/bash
set +x

# Connect iCloud Drive, Google Drive and OneDrive as folders under ~/Cloud.
#
#   omarchy-cloud-drives state                 JSON state for the panel
#   omarchy-cloud-drives setup                 install rclone, encrypt config, install mount unit
#   omarchy-cloud-drives connect <provider>    interactive: sign in and mount
#   omarchy-cloud-drives disconnect <provider> interactive: unmount and forget the account
#   omarchy-cloud-drives mount|unmount <provider>
#   omarchy-cloud-drives open <provider>       open the folder in the file manager
#   omarchy-cloud-drives launch <cmd...>       run a subcommand in a floating terminal
#
# Providers: google, onedrive, icloud.
#
# Security model
#   * rclone's config file (which holds OAuth refresh tokens / the iCloud
#     session) is encrypted by rclone. The encryption password is a random
#     256-bit secret stored only in the login keyring (gnome-keyring via
#     libsecret) and handed to rclone with --password-command; it is never
#     written to disk in the clear or exported as a variable.
#   * Google/OneDrive use OAuth in your browser; this script never sees the
#     account password. iCloud sign-in runs in a separate native window;
#     this shell never collects Apple credentials. rclone retains the regular
#     Apple password inside its encrypted config to renew expired sessions.
#   * Mounts are private to your user (umask 077, no allow-other) and run as
#     hardened systemd user units.

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Re-enter the dispatcher only after the Python launcher sanitizes the child
# environment and applies inherited core-dump protections. Sourcing is an
# internal implementation detail, not an alternate public entry point.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  exec /usr/bin/python3 -Es "$PLUGIN_DIR/bin/protected-exec.py" /bin/bash --noprofile --norc \
    -c 'source "$1" "${@:2}"' cloud-drives "$PLUGIN_DIR/bin/omarchy-cloud-drives" "$@"
fi
if [[ $(ulimit -Sc) != 0 || $(ulimit -Hc) != 0 || ! $(</proc/self/coredump_filter) =~ ^0+$ ]]; then
  echo "Cloud Drives requires its protected launcher." >&2
  return 1
fi
umask 077
MOUNT_ROOT="$HOME/Cloud"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-cloud-drives"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-cloud-drives"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT_NAME="omarchy-cloud-drive@"

SECRET_ATTRS=(service omarchy-cloud-drives key config-password)
# Do not inherit remote definitions, debug dumps, passwords or log locations
# from unrelated rclone use in the user's session.
for rclone_option in ${!RCLONE_@}; do unset "$rclone_option"; done
export RCLONE_PASSWORD_COMMAND="/usr/bin/secret-tool lookup ${SECRET_ATTRS[*]}"
# Each provider owns a separate encrypted config. Never modify a user's
# existing rclone setup or export a global decryption command.
export RCLONE_CONFIG="$CONFIG_DIR/iCloudDrive.conf"
# Resolved once at dispatch, except when launching isolated iCloud sign-in.
# Only setup may download a private runtime.
CLOUD_RCLONE_BIN=""

# id | rclone remote name (= folder name under ~/Cloud) | backend | display name | glyph
PROVIDERS=(
  "google|GoogleDrive|drive|Google Drive|󰊶"
  "onedrive|OneDrive|onedrive|OneDrive|󰏊"
  "icloud|iCloudDrive|iclouddrive|iCloud Drive|󰀸"
)

fail() { echo "omarchy-cloud-drives: $*" >&2; exit 1; }

# write_file <dest> <mode>  (content on stdin)
# Files under the user's config are written to a securely created temporary
# file in the destination directory and moved into place with rename(2).
# rename() is atomic and never follows symlinks, so a planted symlink at the
# destination is replaced, not written through, and there is no check/open race.
write_file() {
  local dest="$1" mode="$2" dir tmp
  dir="$(dirname "$dest")"
  mkdir -p -m 0700 "$dir"
  tmp="$(mktemp "$dir/.$(basename "$dest").XXXXXX")" || fail "cannot create temp file in $dir"
  if ! cat >"$tmp" || ! chmod "$mode" "$tmp" || ! mv -T -f "$tmp" "$dest"; then
    rm -f "$tmp"
    fail "cannot write $dest"
  fi
}

# create_private_file <path>: create an empty 0600 regular file only if
# nothing exists at <path> (link(2) fails on any existing entry, symlinks
# included, so nothing else can be clobbered or written through).
create_private_file() {
  local dest="$1" dir tmp
  dir="$(dirname "$dest")"
  mkdir -p -m 0700 "$dir"
  tmp="$(mktemp "$dir/.$(basename "$dest").XXXXXX")" || fail "cannot create temp file in $dir"
  chmod 0600 "$tmp"
  ln "$tmp" "$dest" 2>/dev/null || true
  rm -f "$tmp"
  [[ -f $dest && ! -L $dest ]] || fail "$dest exists but is not a regular file"
}

provider_field() { # provider_field <id> <n>
  local row
  for row in "${PROVIDERS[@]}"; do
    [[ "${row%%|*}" == "$1" ]] && { cut -d'|' -f"$2" <<<"$row"; return; }
  done
  fail "unknown provider '$1' (google, onedrive, icloud)"
}
remote_of()  { provider_field "$1" 2; }
backend_of() { provider_field "$1" 3; }
name_of()    { provider_field "$1" 4; }
new_cache_id() { /usr/bin/python3 -Es -c 'import uuid; print(uuid.uuid4().hex)'; }

have_rclone()  { [[ -n $CLOUD_RCLONE_BIN && -x $CLOUD_RCLONE_BIN ]]; }
have_secret()  { timeout 5 secret-tool lookup "${SECRET_ATTRS[@]}" >/dev/null 2>&1; }
is_mounted()   { mountpoint -q "$MOUNT_ROOT/$1"; }
unit_of()      { echo "${UNIT_NAME}$(remote_of "$1").service"; }
select_provider() { export RCLONE_CONFIG="$CONFIG_DIR/$(remote_of "$1").conf"; }
remotes()      { have_rclone && timeout 8 "$CLOUD_RCLONE_BIN" listremotes --ask-password=false 2>/dev/null | sed 's/:$//' || true; }
configured()   { select_provider "$1"; remotes | grep -qx "$(remote_of "$1")"; }
config_encrypted() {
  [[ -f $RCLONE_CONFIG && ! -L $RCLONE_CONFIG ]] &&
    head -n 3 "$RCLONE_CONFIG" | grep -qx 'RCLONE_ENCRYPT_V0:'
}

# ---------------------------------------------------------------------------
cmd_state() {
  local rows=() row id remote name glyph conf mounted active error
  local rc=false enc=true key=false ready=false state_error=""
  have_rclone && rc=true
  have_secret && key=true
  for row in "${PROVIDERS[@]}"; do
    IFS='|' read -r id remote _ name glyph <<<"$row"
    select_provider "$id"
    conf=false
    if [[ $key == true ]] && configured "$id"; then conf=true; fi
    config_encrypted || enc=false
    mounted=false; mountpoint -q "$MOUNT_ROOT/$remote" 2>/dev/null && mounted=true
    active=false; timeout 3 systemctl --user is-active --quiet "${UNIT_NAME}${remote}.service" 2>/dev/null && active=true
    error=""
    if timeout 3 systemctl --user is-failed --quiet "${UNIT_NAME}${remote}.service" 2>/dev/null; then
      error="Drive could not mount. Check your connection, then retry or reconnect your account."
    fi
    rows+=("$(jq -nc --arg id "$id" --arg remote "$remote" --arg name "$name" --arg glyph "$glyph" \
      --arg error "$error" --arg path "$MOUNT_ROOT/$remote" --argjson configured "$conf" --argjson mounted "$mounted" --argjson active "$active" \
      '{id:$id,remote:$remote,name:$name,glyph:$glyph,path:$path,configured:$configured,mounted:$mounted,active:$active,error:$error}')")
  done
  if [[ $rc == true && $enc == true && $key == true && -f $UNIT_DIR/${UNIT_NAME}.service ]]; then
    ready=true
  elif [[ $rc != true ]]; then
    state_error="Prepare this computer to install a compatible Cloud Drives runtime."
  elif [[ $enc == true && $key != true ]]; then
    state_error="Unlock your login keyring, then check again."
  fi
  jq -nc --argjson rclone "$rc" --argjson encrypted "$enc" --argjson keyring "$key" --arg root "$MOUNT_ROOT" \
    --argjson ready "$ready" --arg error "$state_error" \
    --argjson providers "$(printf '%s\n' "${rows[@]}" | jq -sc .)" \
    '{rclone:$rclone,encrypted:$encrypted,keyring:$keyring,ready:$ready,error:$error,root:$root,providers:$providers}'
}

# ---------------------------------------------------------------------------
ensure_rclone() {
  if ! command -v fusermount3 >/dev/null; then
    echo "Preparing cloud drive support..."
    omarchy pkg add fuse3
  fi
  echo "Checking the Cloud Drives runtime..."
  CLOUD_RCLONE_BIN="$(/usr/bin/python3 -Es "$PLUGIN_DIR/bin/cloud_drives_runtime.py" prepare)" || fail "Cloud Drives runtime preparation failed. Your system rclone was not changed."
  have_rclone || fail "Cloud Drives runtime is unavailable."
  command -v secret-tool >/dev/null || fail "Login keyring support is missing (libsecret)."
}

ensure_secret() {
  have_secret && return
  # Losing/unlocking a key is different from first-time setup. Never silently
  # replace the key for an existing encrypted config.
  local existing
  for existing in "$CONFIG_DIR"/*.conf; do
    [[ -e $existing ]] && fail "Unlock your login keyring before continuing. Your existing credentials have been kept."
  done
  echo "Creating a config encryption key in your login keyring..."
  # 256 bits of randomness; never printed, never stored outside the keyring.
  head -c 32 /dev/urandom | base64 -w0 \
    | secret-tool store --label="Omarchy Cloud Drives: rclone config password" "${SECRET_ATTRS[@]}"
  have_secret || fail "could not store the key in the keyring (is gnome-keyring unlocked?)"
}

ensure_encrypted() {
  create_private_file "$RCLONE_CONFIG"
  chmod 0600 "$RCLONE_CONFIG"
  config_encrypted && return
  echo "Encrypting the rclone config with the keyring key..."
  # With --password-command set, `encryption set` takes the NEW password from it.
  "$CLOUD_RCLONE_BIN" config encryption set
  config_encrypted || fail "config encryption failed"
}

ensure_unit() {
  mkdir -p -m 0700 "$MOUNT_ROOT"
  [[ -d $MOUNT_ROOT && ! -L $MOUNT_ROOT ]] || fail "$MOUNT_ROOT is not a directory"
  /usr/bin/python3 -Es "$PLUGIN_DIR/bin/render-unit.py" "$PLUGIN_DIR/systemd/${UNIT_NAME}.service" \
    "$CONFIG_DIR" "$MOUNT_ROOT" "$CACHE_DIR" "$PLUGIN_DIR/bin/mount-drive.py" "$DATA_HOME" | write_file "$UNIT_DIR/${UNIT_NAME}.service" 0644
  systemctl --user daemon-reload
}

cmd_setup() {
  ensure_rclone
  ensure_secret
  local id
  for id in google onedrive icloud; do
    select_provider "$id"
    ensure_encrypted
  done
  ensure_unit
  echo "Cloud Drives is ready. Folders will appear under $MOUNT_ROOT"
}

# ---------------------------------------------------------------------------
cmd_connect() {
  local id="$1" remote backend name
  if [[ $id == icloud ]]; then
    exec /usr/bin/python3 -Es "$PLUGIN_DIR/bin/icloud-signin.py"
  fi
  remote="$(remote_of "$id")"; backend="$(backend_of "$id")"; name="$(name_of "$id")"
  cmd_setup
  select_provider "$id"
  if configured "$id"; then
    echo "$name is already connected."
  else
    echo
    echo "Connecting $name ..."
    case "$id" in
      google)
        echo "A browser window will open for Google sign-in."
        "$CLOUD_RCLONE_BIN" config create "$remote" drive scope=drive config_is_local=true omarchy_cache_id="$(new_cache_id)"
        ;;
      onedrive)
        echo "A browser window will open for Microsoft sign-in, then pick your drive."
        "$CLOUD_RCLONE_BIN" config create "$remote" onedrive omarchy_cache_id="$(new_cache_id)"
        ;;
    esac
    configured "$id" || fail "$name was not configured"
  fi
  echo "Testing the connection..."
  "$CLOUD_RCLONE_BIN" about "$remote:" 2>/dev/null || "$CLOUD_RCLONE_BIN" lsd --max-depth 1 "$remote:" >/dev/null
  cmd_mount "$id"
  echo "$name is mounted at $MOUNT_ROOT/$remote"
}

cmd_disconnect() {
  local id="$1" remote name
  remote="$(remote_of "$id")"; name="$(name_of "$id")"
  gum confirm "Disconnect $name and forget its credentials on this machine?" || exit 130
  cmd_unmount "$id"
  configured "$id" && "$CLOUD_RCLONE_BIN" config delete "$remote"
  rmdir "$MOUNT_ROOT/$remote" 2>/dev/null || true
  echo "$name disconnected."
}

cmd_mount() {
  local id="$1" unit; unit="$(unit_of "$id")"
  configured "$id" || fail "$(name_of "$id") is not connected yet"
  [[ -f $UNIT_DIR/${UNIT_NAME}.service ]] || ensure_unit
  timeout 50 systemctl --user enable --now "$unit" || fail "Drive could not mount. Check your connection or reconnect your account."
  is_mounted "$(remote_of "$id")" || fail "The service started but the drive is not mounted. Try reconnecting."
}

cmd_unmount() {
  local id="$1" unit; unit="$(unit_of "$id")"
  timeout 50 systemctl --user disable --now "$unit" || fail "The drive could not be stopped. Close files using it and try again."
  ! is_mounted "$(remote_of "$id")" || fail "The drive is still mounted. Close files using it and try again."
}

cmd_reconnect_mount() {
  local id="$1" unit; unit="$(unit_of "$id")"
  # Authentication has already committed a verified replacement config.
  timeout 50 systemctl --user stop "$unit" || fail "Could not stop the previous connection."
  cmd_mount "$id"
}

cmd_reconnect() {
  local id="$1"
  if [[ $id == icloud ]]; then
    exec /usr/bin/python3 -Es "$PLUGIN_DIR/bin/icloud-signin.py"
  fi
  configured "$id" || fail "Connect this account first."
  timeout 50 systemctl --user stop "$(unit_of "$id")" || fail "Could not stop the current connection."
  echo "Approve the sign-in request on your trusted device when asked."
  "$CLOUD_RCLONE_BIN" config reconnect "$(remote_of "$id"):"
  cmd_reconnect_mount "$id"
}

window_for() { # window_for <title>
  hyprctl clients -j | jq -r --arg t "$1" '[.[] | select(.title == $t and .mapped)] | .[0].address // empty'
}

focus_window() { # focus_window <address>
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1 \
    || hyprctl dispatch focuswindow "address:$1" >/dev/null 2>&1 || true
}

cmd_open() {
  local remote dir addr i; remote="$(remote_of "$1")"; dir="$MOUNT_ROOT/$remote"
  is_mounted "$remote" || cmd_mount "$1"
  # Reuse an existing file-manager window for this folder; otherwise open one
  # and focus it once it maps (it may land on another monitor's workspace).
  addr="$(window_for "$remote")"
  if [[ -z $addr ]]; then
    setsid uwsm-app -- xdg-open "$dir" >/dev/null 2>&1 &
    for ((i = 0; i < 50; i++)); do
      addr="$(window_for "$remote")"
      [[ -n $addr ]] && break
      read -t 0.1 <> <(:) || true
    done
  fi
  [[ -n $addr ]] && focus_window "$addr"
  return 0
}

cmd_launch() {
  exec omarchy-launch-floating-terminal-with-presentation "$(printf '%q ' "${BASH_SOURCE[0]}" "$@")"
}

# ---------------------------------------------------------------------------
# Opening iCloud sign-in must not run setup, query/decrypt a config, or even
# probe rclone. The isolated launcher owns its preparation and authentication.
case "${1:-}:${2:-}" in
  connect:icloud|reconnect:icloud) ;;
  *) CLOUD_RCLONE_BIN="$(/usr/bin/python3 -Es "$PLUGIN_DIR/bin/cloud_drives_runtime.py" path 2>/dev/null || true)" ;;
esac

case "${1:-}" in
  state)      cmd_state ;;
  setup)      cmd_setup ;;
  connect)    cmd_connect "${2:?provider}" ;;
  disconnect) cmd_disconnect "${2:?provider}" ;;
  mount)      cmd_mount "${2:?provider}" ;;
  reconnect-mount) cmd_reconnect_mount "${2:?provider}" ;;
  reconnect)  cmd_reconnect "${2:?provider}" ;;
  unmount)    cmd_unmount "${2:?provider}" ;;
  open)       cmd_open "${2:?provider}" ;;
  launch)     shift; cmd_launch "$@" ;;
  *) sed -n '3,20p' "${BASH_SOURCE[0]}"; exit 1 ;;
esac
